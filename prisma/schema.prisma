generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  password      String?
  username      String?   @unique
  bio           String?
  location      String?
  website       String?
  coverImage    String?
  customTheme   Json?
  isAdmin       Boolean   @default(false)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts         Account[]
  sessions         Session[]
  posts            Post[]
  likes            Like[]
  comments         Comment[]
  payments         Payment[]
  postCredits      Int       @default(0)
  lastFreePostDate DateTime?

  sentMessages  Message[]                 @relation("SentMessages")
  conversations ConversationParticipant[]

  // Forum relations
  threads           Thread[]        @relation("ThreadAuthor")
  threadComments    ThreadComment[] @relation("ThreadCommentAuthor")
  moderationActions ModerationLog[] @relation("ModeratorActions")
  moderatedActions  ModerationLog[] @relation("ModeratedUser")
  bans              UserBan[]       @relation("BannedUser")
  issuedBans        UserBan[]       @relation("BanIssuer")
  isModerator       Boolean         @default(false)
  isBanned          Boolean         @default(false)
}

model Post {
  id             String       @id @default(cuid())
  title          String
  description    String       @db.Text
  images         String[]
  price          Float?
  isGallery      Boolean      @default(false)
  isBoosted      Boolean      @default(false)
  boostExpiresAt DateTime?
  views          Int          @default(0)
  authorId       String
  categoryId     String?
  subcategoryId  String?
  author         User         @relation(fields: [authorId], references: [id], onDelete: Cascade)
  category       Category?    @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  subcategory    Subcategory? @relation(fields: [subcategoryId], references: [id], onDelete: SetNull)
  likes          Like[]
  comments       Comment[]
  shares         Int          @default(0)
  status         PostStatus   @default(ACTIVE)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([authorId])
  @@index([createdAt])
  @@index([isBoosted])
  @@index([categoryId])
  @@index([subcategoryId])
}

enum PostStatus {
  ACTIVE
  PENDING
  REJECTED
  DELETED
}

model Like {
  id        String   @id @default(cuid())
  userId    String
  postId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, postId])
  @@index([postId])
}

model Comment {
  id        String   @id @default(cuid())
  content   String   @db.Text
  userId    String
  postId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([postId])
  @@index([userId])
}

model Conversation {
  id           String                    @id @default(cuid())
  postId       String?
  participants ConversationParticipant[]
  messages     Message[]
  createdAt    DateTime                  @default(now())
  updatedAt    DateTime                  @updatedAt

  @@index([postId])
}

model ConversationParticipant {
  id             String       @id @default(cuid())
  conversationId String
  userId         String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  lastReadAt     DateTime?
  createdAt      DateTime     @default(now())

  @@unique([conversationId, userId])
  @@index([userId])
}

model Message {
  id             String       @id @default(cuid())
  content        String       @db.Text
  senderId       String
  conversationId String
  sender         User         @relation("SentMessages", fields: [senderId], references: [id], onDelete: Cascade)
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  createdAt      DateTime     @default(now())

  @@index([conversationId])
  @@index([senderId])
}

model Payment {
  id                String          @id @default(cuid())
  userId            String
  amount            Float
  currency          String          @default("EUR")
  provider          PaymentProvider
  providerPaymentId String?
  type              PaymentType
  quantity          Int
  status            PaymentStatus   @default(PENDING)
  user              User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  @@index([userId])
  @@index([status])
}

enum PaymentProvider {
  PAYPAL
  MYPOS
}

enum PaymentType {
  POST_CREDITS
  BOOST
}

enum PaymentStatus {
  PENDING
  COMPLETED
  FAILED
  REFUNDED
}

model Settings {
  id          String   @id @default(cuid())
  key         String   @unique
  value       String   @db.Text
  description String?
  updatedAt   DateTime @updatedAt
}

model Forum {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  description String   @db.Text
  icon        String?
  color       String?
  order       Int      @default(0)
  isActive    Boolean  @default(true)
  threads     Thread[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([slug])
  @@index([order])
}

model Thread {
  id             String          @id @default(cuid())
  title          String
  content        String          @db.Text
  forumId        String
  authorId       String
  isPinned       Boolean         @default(false)
  isLocked       Boolean         @default(false)
  status         ThreadStatus    @default(ACTIVE)
  views          Int             @default(0)
  forum          Forum           @relation(fields: [forumId], references: [id], onDelete: Cascade)
  author         User            @relation("ThreadAuthor", fields: [authorId], references: [id], onDelete: Cascade)
  comments       ThreadComment[]
  moderationLogs ModerationLog[]
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  @@index([forumId])
  @@index([authorId])
  @@index([isPinned])
  @@index([status])
  @@index([createdAt])
}

enum ThreadStatus {
  ACTIVE
  PENDING
  FLAGGED
  DELETED
  LOCKED
}

model ThreadComment {
  id             String          @id @default(cuid())
  content        String          @db.Text
  threadId       String
  authorId       String
  parentId       String?
  status         CommentStatus   @default(ACTIVE)
  thread         Thread          @relation(fields: [threadId], references: [id], onDelete: Cascade)
  author         User            @relation("ThreadCommentAuthor", fields: [authorId], references: [id], onDelete: Cascade)
  parent         ThreadComment?  @relation("CommentReplies", fields: [parentId], references: [id], onDelete: Cascade)
  replies        ThreadComment[] @relation("CommentReplies")
  moderationLogs ModerationLog[]
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  @@index([threadId])
  @@index([authorId])
  @@index([parentId])
  @@index([status])
}

enum CommentStatus {
  ACTIVE
  PENDING
  FLAGGED
  DELETED
}

model ModerationLog {
  id           String           @id @default(cuid())
  action       ModerationAction
  reason       String?          @db.Text
  moderatorId  String
  targetUserId String?
  threadId     String?
  commentId    String?
  postId       String?
  moderator    User             @relation("ModeratorActions", fields: [moderatorId], references: [id])
  targetUser   User?            @relation("ModeratedUser", fields: [targetUserId], references: [id])
  thread       Thread?          @relation(fields: [threadId], references: [id])
  comment      ThreadComment?   @relation(fields: [commentId], references: [id])
  createdAt    DateTime         @default(now())

  @@index([moderatorId])
  @@index([targetUserId])
  @@index([threadId])
  @@index([commentId])
  @@index([createdAt])
}

enum ModerationAction {
  PIN_THREAD
  UNPIN_THREAD
  LOCK_THREAD
  UNLOCK_THREAD
  DELETE_THREAD
  RESTORE_THREAD
  DELETE_COMMENT
  RESTORE_COMMENT
  FLAG_THREAD
  UNFLAG_THREAD
  FLAG_COMMENT
  UNFLAG_COMMENT
  BAN_USER
  UNBAN_USER
  WARN_USER
  DELETE_POST
  APPROVE_POST
  APPROVE_THREAD
  APPROVE_COMMENT
}

model UserBan {
  id          String    @id @default(cuid())
  userId      String
  bannedById  String
  reason      String    @db.Text
  expiresAt   DateTime?
  isPermanent Boolean   @default(false)
  isActive    Boolean   @default(true)
  user        User      @relation("BannedUser", fields: [userId], references: [id], onDelete: Cascade)
  bannedBy    User      @relation("BanIssuer", fields: [bannedById], references: [id])
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([userId])
  @@index([isActive])
  @@index([expiresAt])
}

model StaticPage {
  id        String   @id @default(cuid())
  slug      String   @unique
  titleEn   String
  titleBg   String
  contentEn String   @db.Text
  contentBg String   @db.Text
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([slug])
}

model Category {
  id            String        @id @default(cuid())
  nameEn        String
  nameBg        String
  slug          String        @unique
  descriptionEn String?       @db.Text
  descriptionBg String?       @db.Text
  icon          String?
  order         Int           @default(0)
  isActive      Boolean       @default(true)
  subcategories Subcategory[]
  posts         Post[]
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  @@index([slug])
  @@index([order])
  @@index([isActive])
}

model Subcategory {
  id            String   @id @default(cuid())
  nameEn        String
  nameBg        String
  slug          String   @unique
  descriptionEn String?  @db.Text
  descriptionBg String?  @db.Text
  categoryId    String
  order         Int      @default(0)
  isActive      Boolean  @default(true)
  category      Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  posts         Post[]
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([slug])
  @@index([categoryId])
  @@index([order])
  @@index([isActive])
}
